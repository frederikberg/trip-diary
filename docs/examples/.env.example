TRIP_HOST=trip.example.org
TRIP_EDIT_HOST=trip-edit.example.org
# Addresses that may edit, comma-separated.
EDITOR_EMAILS=you@example.org

# Immich as the app container reaches it, and an API key with asset.read and asset.view
# (album.read too, for photos from albums shared with the key's user).
IMMICH_URL=http://immich-server:2283
IMMICH_API_KEY=
# A long random value, for example: openssl rand -hex 32
ADMIN_TOKEN=

OIDC_ISSUER_URL=https://id.example.org
OIDC_CLIENT_ID=trip-diary
OIDC_CLIENT_SECRET=
# openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_COOKIE_SECRET=
