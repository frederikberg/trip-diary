{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!renovate.json",
      "!dist",
      "!node_modules",
      "!bun.lock",
      "!web/index.html",
      "!web/map.html",
      "!web/map/style.json",
      "!**/*.md"
    ]
  },
  "linter": {
    "rules": { "suspicious": { "noAssignInExpressions": "off" }, "style": { "noDescendingSpecificity": "off" } }
  },
  "overrides": [
    { "includes": ["test/trip-cli.test.ts"], "linter": { "rules": { "suspicious": { "noExplicitAny": "off" } } } }
  ],
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "double" } }
}
