{
  "name": "trip-diary",
  "version": "0.11.0",
  "description": "A map diary of a trip: walked GPX tracks, numbered notes and photos from your own Immich, behind your own login proxy.",
  "license": "MIT",
  "author": "Frederik Berg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frederikberg/trip-diary.git"
  },
  "homepage": "https://github.com/frederikberg/trip-diary#readme",
  "bugs": {
    "url": "https://github.com/frederikberg/trip-diary/issues"
  },
  "type": "module",
  "scripts": {
    "build": "bun scripts/build-web.ts",
    "start": "bun src/server/main.ts",
    "dev": "bun scripts/build-web.ts && TRIP_CONFIG_OVERRIDE=config-custom/config.dev.yaml bun --watch src/server/main.ts",
    "check": "tsc --noEmit && biome check .",
    "test": "bun test test/",
    "selftest": "bun e2e/selftest.ts"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "leaflet": "1.9.4",
    "maplibre-gl": "6.16.0",
    "marked": "18.1.3",
    "photoswipe": "5.4.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/bun": "1.4.4",
    "@types/leaflet": "1.9.22",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2"
  }
}
